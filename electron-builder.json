{
  "appId": "com.abhishekkuntare.abhishekos",
  "productName": "ARLO OS",
  "copyright": "Copyright © 2026 Abhishek Kuntare",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "publish": {
    "provider": "github",
    "owner": "Abhishekkuntare",
    "repo": "abhishek-mac-os",
    "releaseType": "release"
  },
  "files": [
    "dist/**/*",
    "electron-main.mjs",
    "ghost-api-key.mjs",
    "ghost-agent-service.mjs",
    "electron-preload.cjs",
    "code-runner.mjs",
    "package.json",
    "assets/icon.ico"
  ],
  "extraResources": [
    {
      "from": "build/ghost-voice/dist/GhostVoice",
      "to": "ghost-voice"
    }
  ],
  "extraMetadata": {
    "main": "electron-main.mjs"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "ARLO-OS-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ARLO OS",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}